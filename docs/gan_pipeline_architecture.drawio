        <mxCell id="s3_paso1" parent="s3_bg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;fontSize=10;" value="&lt;b&gt;PASO 1 - Discriminador&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Toma half_batch trazas reales de X&lt;br&gt;2. Genera fake_traces = G(noise)&lt;br&gt;&lt;br&gt;D.train_on_batch(real_traces, &lt;b&gt;0.9&lt;/b&gt;)&lt;br&gt;&lt;i&gt;  (label smoothing, no 1.0)&lt;/i&gt;&lt;br&gt;D.train_on_batch(fake_traces, &lt;b&gt;0.0&lt;/b&gt;)&lt;br&gt;&lt;br&gt;d_loss = 0.5 x (d_real + d_fake)" vertex="1">
          <mxGeometry height="165" width="265" x="900" y="210" as="geometry" />
        </mxCell>
        <mxCell id="s3_paso2" parent="s3_bg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;fontSize=10;" value="&lt;b&gt;PASO 2 - Generador&lt;/b&gt;&lt;br&gt;&lt;br&gt;D.trainable = &lt;b&gt;False&lt;/b&gt;&lt;br&gt;&lt;br&gt;combined.train_on_batch(&lt;br&gt;  noise, target=&lt;b&gt;1.0&lt;/b&gt;)&lt;br&gt;&lt;i&gt;  (quiero que D diga real)&lt;/i&gt;&lt;br&gt;&lt;br&gt;gradiente -&gt; solo hacia G&lt;br&gt;D.trainable = &lt;b&gt;True&lt;/b&gt;" vertex="1">
